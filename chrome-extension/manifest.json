{
  "manifest_version": 3,
  "name": "LinkedIn Lead Extractor",
  "version": "1.0.0",
  "description": "Extract LinkedIn contacts via Apify, enrich with Apollo, sync to Bitzsol CRM.",
  "permissions": ["activeTab", "cookies", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.apify.com/*",
    "https://api.apollo.io/*",
    "https://api.bitzsol.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract LinkedIn Lead"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
